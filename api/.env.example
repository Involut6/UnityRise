# --- required ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# seed script only (creates/resets the super admin)
ADMIN_EMAIL=admin@unityrise.example
ADMIN_PASSWORD=change-me-12+chars
# --- optional ---
NODE_ENV=development            # development | test | staging | production (simulate endpoint is disabled in staging/production)
PORT=3000
CORS_ORIGIN=http://localhost:5173   # comma-separated; '*' rejected in production
UPLOAD_DIR=uploads
PAYSTACK_WEBHOOK_SECRET=        # webhooks for a provider are rejected (401) until its secret is set
FLUTTERWAVE_WEBHOOK_SECRET=
LOGIN_MAX_FAILURES=5            # failed logins before the account locks
LOGIN_LOCK_MINUTES=15
